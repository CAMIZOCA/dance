<IfModule mod_rewrite.c>
    Options -Indexes

    RewriteEngine On

    RewriteRule ^api(/.*)?$ backend/public/index.php [END,QSA]

    RewriteCond %{DOCUMENT_ROOT}/frontend/dist/index.html -f
    RewriteCond %{DOCUMENT_ROOT}/frontend/dist/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/frontend/dist/$1 -d
    RewriteRule ^(.*)$ frontend/dist/$1 [END]

    RewriteCond %{DOCUMENT_ROOT}/frontend/dist/index.html -f
    RewriteRule ^ frontend/dist/index.html [END]

    RewriteRule ^ backend/public/index.php [END]
</IfModule>
